# База данных (для collection и других Go-сервисов)
DATABASE_DSN=postgres://finapp:finapp@localhost:5432/finapp?sslmode=disable

# Сервис collection
PORT=8080
JWT_SECRET=dev-secret-change-in-production
ML_SERVICE_URL=http://localhost:8000
PROCESSING_SERVICE_URL=http://localhost:8081

# ML service real model mode
INSTALL_REAL_MODEL_DEPS=true
ENABLE_REAL_MODELS=true
WHISPER_MODEL_ID=openai/whisper-large-v3
